# Directus Configuration
# Copy this file to .env and fill in the values

# Directus Keys
DIRECTUS_KEY=your_random_key_here
DIRECTUS_SECRET=your_random_secret_here

# Database Configuration
DIRECTUS_DB_DATABASE=directus
DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=your_secure_password_here

# Admin Credentials
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=your_admin_password_here

# Public URL
DIRECTUS_PUBLIC_URL=http://localhost:8055
