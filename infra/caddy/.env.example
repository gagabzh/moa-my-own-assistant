# Caddy Reverse Proxy Configuration - Exemple
# Phase 1.5 - Développement local

# =============================================================================
# Configuration pour développement local (certificats auto-signés)
# =============================================================================
# Aucune configuration requise pour le développement local.
# Les certificats auto-signés sont générés automatiquement.

# =============================================================================
# Configuration pour production (avec Let's Encrypt)
# =============================================================================
# Décommentez et configurez pour une utilisation en production :

# Email pour Let's Encrypt (obligatoire)
# CADDY_EMAIL=your-email@example.com

# Domaine par défaut
# CADDY_DOMAIN=moa.yourdomain.com

# =============================================================================
# Répertoires de stockage (optionnel)
# =============================================================================
# Ces répertoires sont montés comme volumes Docker
# CADDY_DATA_DIR=./caddy_data
# CADDY_CONFIG_DIR=./caddy_config

# =============================================================================
# Variables Docker (gérées par docker-compose)
# =============================================================================
# CADDY_DOCKER_PROXY_INIT=true
# CADDY_DOCKER_PROXY_NETWORK=moa-network
