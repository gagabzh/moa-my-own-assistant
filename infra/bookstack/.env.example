# BookStack Configuration
# Copy this file to .env and customize the values

# Application URL
BOOKSTACK_APP_URL=http://localhost:6875

# Database Configuration
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=bookstack
BOOKSTACK_ROOT_PASSWORD=rootpassword

# Email Configuration (optional - for notifications)
BOOKSTACK_MAIL_FROM=bookstack@localhost
BOOKSTACK_MAIL_NAME=BookStack
BOOKSTACK_MAIL_DRIVER=smtp
BOOKSTACK_MAIL_HOST=
BOOKSTACK_MAIL_PORT=587
BOOKSTACK_MAIL_USERNAME=
BOOKSTACK_MAIL_PASSWORD=
BOOKSTACK_MAIL_ENCRYPTION=tls

# Application Settings
BOOKSTACK_TIMEZONE=Europe/Paris
BOOKSTACK_LOCALE=fr

# MCP Server Configuration
# URL to BookStack API (from MCP server perspective)
BOOKSTACK_MCP_BASE_URL=http://bookstack:80/api
# BookStack API Token (format: token_id:token_secret)
BOOKSTACK_MCP_API_TOKEN=
# MCP Server Auth Token (for incoming requests)
BOOKSTACK_MCP_AUTH_TOKEN=
# Transport mode: http or stdio
BOOKSTACK_MCP_TRANSPORT=http
