# BookStack Configuration
# Copy this file to .env and customize the values

# Application URL
BOOKSTACK_APP_URL=http://localhost:6875

# Database Configuration
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=bookstack
BOOKSTACK_ROOT_PASSWORD=rootpassword

# Email Configuration (optional - for notifications)
BOOKSTACK_MAIL_FROM=bookstack@localhost
BOOKSTACK_MAIL_NAME=BookStack
BOOKSTACK_MAIL_DRIVER=smtp
BOOKSTACK_MAIL_HOST=
BOOKSTACK_MAIL_PORT=587
BOOKSTACK_MAIL_USERNAME=
BOOKSTACK_MAIL_PASSWORD=
BOOKSTACK_MAIL_ENCRYPTION=tls

# Application Settings
BOOKSTACK_TIMEZONE=Europe/Paris
BOOKSTACK_LOCALE=fr
