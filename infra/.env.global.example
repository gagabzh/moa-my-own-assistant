DIRECTUS_KEY=1a1d9343df4525c24ea1f12f4c2c2fa776193b73143b4b18eb9292aea811fb52
DIRECTUS_SECRET=c85dbbcf540e1b1f4d51ef1eacc8594a1cbc789b5fc811064161ddb44a74ea86

