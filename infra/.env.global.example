# =============================================================================
# MOA - Configuration Globale de la Stack
# Copiez ce fichier en .env.global et adaptez les valeurs
# =============================================================================

# =============================================================================
# VIKUNJA - Gestionnaire de tâches
# =============================================================================
# Secret key (au moins 32 caractères)
VIKUNJA_SECRET=your-super-secret-key-change-me-in-production

# URL publique
VIKUNJA_PUBLIC_URL=http://localhost:3456

# Mot de passe de la base de données
VIKUNJA_DB_PASSWORD=vikunja

# Activer l'inscription ouverte (true pour développement local)
VIKUNJA_ENABLE_OPEN_REGISTRATION=true

# =============================================================================
# BOOKSTACK - Documentation & Wiki
# =============================================================================
# URL de l'application
BOOKSTACK_APP_URL=http://localhost:6875

# Configuration de la base de données
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=bookstack
BOOKSTACK_ROOT_PASSWORD=rootpassword

# Paramètres de l'application
BOOKSTACK_TIMEZONE=Europe/Paris
BOOKSTACK_LOCALE=fr
BOOKSTACK_APP_KEY=base64:5rrio/05WCaVZXxdSlrg6eRuh+At3D89nPTVMiQMMak=

# Configuration du serveur MCP
BOOKSTACK_MCP_BASE_URL=http://bookstack:80/api
BOOKSTACK_MCP_API_TOKEN=cb226ee78ddbd5834779835113e5d626:9ad2c132e691503a40674b748bce63031a0f2bb39d3a293e2abbd36c3f0dc302
BOOKSTACK_MCP_AUTH_TOKEN=changeme_mcp_auth_token_32_chars
BOOKSTACK_MCP_TRANSPORT=http

# =============================================================================
# DIRECTUS - Gestion de données
# =============================================================================
