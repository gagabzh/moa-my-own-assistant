# Forgejo Configuration
# Copy this file to .env and adjust values as needed

# Port configuration
FORGEJO_HTTP_PORT=3001
FORGEJO_SSH_PORT=2223

# Domain and URL settings
FORGEJO_DOMAIN=localhost
FORGEJO_SSH_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3001/

# Database settings (optional - Forgejo uses SQLite by default)
# FORGEJO_DB_TYPE=mysql
# FORGEJO_DB_HOST=mysql
# FORGEJO_DB_PORT=3306
# FORGEJO_DB_NAME=forgejo
# FORGEJO_DB_USER=forgejo
# FORGEJO_DB_PASSWORD=your_password

# Admin user (first user created will be admin)
# No specific config needed - first registered user is admin

# Security settings
# Set to true to require sign-in to view repositories
# FORGEJO_REQUIRE_SIGNIN_VIEW=false

# Set to true to disable user registration
# FORGEJO_DISABLE_REGISTRATION=false

# SMTP settings (optional)
# FORGEJO_SMTP_ENABLED=true
# FORGEJO_SMTP_HOST=smtp.example.com
# FORGEJO_SMTP_PORT=587
# FORGEJO_SMTP_USER=user@example.com
# FORGEJO_SMTP_PASSWORD=password
# FORGEJO_SMTP_FROM=user@example.com

# Runner settings (CI/CD - optional)
# FORGEJO_RUNNER_ENABLED=true
# FORGEJO_RUNNER_REGISTRATION_TOKEN=your_token
